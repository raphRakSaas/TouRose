---
import type { PublicPlaceRow } from '@tourose/contracts';
import { formatPlaceType, formatPriceBadge } from '../lib/format';

interface Props {
  placeRow: PublicPlaceRow;
  variant?: 'catalogue' | 'bento-tile';
  tileLabel?: string;
  tileIcon?: string;
}

const { placeRow, variant = 'catalogue', tileLabel, tileIcon = 'place' } = Astro.props;
const priceBadge = formatPriceBadge(placeRow.price_type);
const placeTypeLabel = formatPlaceType(placeRow.place_type);
const metaLine = placeRow.city ? `${placeTypeLabel} • ${placeRow.city}` : placeTypeLabel;
const href = `/catalogue/lieux/${placeRow.slug}`;
const displayLabel = tileLabel ?? placeTypeLabel;
const priceToneClass = priceBadge.tone === 'free' ? 'text-primary' : 'text-secondary';
---

{
  variant === 'bento-tile' ? (
    <a href={href} class="group relative block h-[280px] overflow-hidden rounded-[32px] shadow-xl">
      {placeRow.image_url ? (
        <img
          src={placeRow.image_url}
          alt={placeRow.image_alt ?? placeRow.name}
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-1000 group-hover:scale-105"
        />
      ) : (
        <div class="absolute inset-0 bg-gradient-to-br from-tertiary/20 to-sky-blue-muted/30" />
      )}
      <div class="absolute inset-0 flex items-center justify-center bg-ink-black/30 p-6 text-center transition-colors group-hover:bg-ink-black/50">
        <div>
          <span class="material-symbols-outlined mb-2 text-4xl text-white">{tileIcon}</span>
          <h4 class="font-headline-md text-white">{displayLabel}</h4>
          <p class="mt-1 font-label-sm text-label-sm text-white/80">{placeRow.name}</p>
        </div>
      </div>
    </a>
  ) : (
    <a href={href} class="group block no-underline">
      <article>
        <div class="relative mb-4 aspect-[4/5] overflow-hidden rounded-2xl border border-soft-pink/20 card-shadow-sm">
          {placeRow.image_url ? (
            <img
              src={placeRow.image_url}
              alt={placeRow.image_alt ?? placeRow.name}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          ) : (
            <div class="flex h-full items-center justify-center bg-gradient-to-br from-tertiary/10 via-sky-blue-muted/20 to-soft-pink/20 font-label-sm text-on-surface-variant">
              Lieu
            </div>
          )}
          <div
            class:list={[
              'absolute top-4 right-4 rounded-full bg-white/90 px-3 py-1 font-label-sm text-label-sm font-bold backdrop-blur-sm',
              priceToneClass,
            ]}
          >
            {priceBadge.label}
          </div>
          <div class="absolute right-0 bottom-0 left-0 bg-gradient-to-t from-ink-black/80 to-transparent p-6">
            <span class="font-label-sm text-label-sm font-medium tracking-wider text-white/80 uppercase">
              {metaLine}
            </span>
          </div>
        </div>
        <h3 class="font-headline-md text-headline-md text-ink-black transition-colors group-hover:text-primary">
          {placeRow.name}
        </h3>
        {placeRow.summary ? (
          <p class="mt-1 line-clamp-2 font-body-md text-body-md text-on-surface-variant">{placeRow.summary}</p>
        ) : null}
      </article>
    </a>
  )
}
