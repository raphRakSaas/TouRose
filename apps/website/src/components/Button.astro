---
type ButtonVariant = 'primary' | 'secondary' | 'outline' | 'ghost' | 'white';

interface Props {
  href?: string;
  variant?: ButtonVariant;
  class?: string;
  type?: 'button' | 'submit';
  id?: string;
  disabled?: boolean;
}

const {
  href,
  variant = 'primary',
  class: className = '',
  type = 'button',
  id,
  disabled = false,
} = Astro.props;

const baseClass =
  'tr-btn inline-flex cursor-pointer items-center justify-center gap-2 rounded-full text-sm font-semibold no-underline transition';

const variantClass: Record<ButtonVariant, string> = {
  primary:
    'bg-gradient-to-r from-brick-500 to-brick-600 px-6 py-3 text-white shadow-lg shadow-brick-500/25 hover:shadow-brick-500/35',
  secondary: 'bg-ink-800 px-6 py-3 text-white shadow-lg shadow-ink-800/20 hover:bg-ink-700',
  outline:
    'border border-ink-800/12 bg-white/70 px-6 py-3 text-ink-800 backdrop-blur hover:bg-white',
  ghost: 'px-2 py-2 text-brick-700 hover:text-brick-600',
  white: 'bg-white px-6 py-3 text-ink-800 shadow-md hover:bg-sand-50',
};

const classes = `${baseClass} ${variantClass[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes} id={id}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} id={id} disabled={disabled}>
      <slot />
    </button>
  )
}
