---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONTACT_EMAIL } from '../lib/site-config';

const photoBannerImage =
  'https://lh3.googleusercontent.com/aida-public/AB6AXuD5mwGgx0dG59db6t8y7vq-jxEjVgefZEbTgGSOrzyAI7OmxKiaMpb_uffe0N3Ong6cHcdELJQB6ZP3vYV3o78cLG_fTrN_MPGCHAWx2sldYRT_cS7dlRlVQF88ROB6Xj363-KKuCI4z6-pLz1VArkmdYOw6lmqMW90U7tj3s0xhhjaW6TOaM9sYoPAiw04-uRVzYfzpZg4ViJig_o5l0MxEmyI1eGXDLQQcrvNcQqzKqP8VXu151oDLD_MvIsFCS9Y2HY7Zzi5cQY';
---

<BaseLayout
  title="Crédits et sources — TouRose"
  description="Sources de données, attributions et licences utilisées par TouRose."
>
  <main class="mx-auto max-w-[1200px] px-container-margin pt-32 pb-section-gap">
    <section class="mb-section-gap">
      <div class="max-w-2xl">
        <h1 class="mb-4 font-headline-xl text-headline-xl text-deep-rose">Crédits &amp; Coulisses</h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant">
          TouRose est une initiative indépendante née de l'amour pour Toulouse. On croit en la transparence et en la
          puissance de l'open data pour faire vibrer notre Ville Rose.
        </p>
      </div>
    </section>

    <div class="grid grid-cols-1 gap-gutter md:grid-cols-12">
      <div class="paper-card flex flex-col justify-between rounded-xl bg-white p-8 md:col-span-8">
        <div>
          <div class="mb-6 flex items-center gap-3">
            <span class="material-symbols-outlined text-3xl text-terra-cotta">database</span>
            <h2 class="font-headline-md text-headline-md text-ink-black">Transparence des Données</h2>
          </div>
          <p class="mb-8 leading-relaxed text-on-surface-variant">
            TouRose n'existerait pas sans la richesse des données publiques et des flux ouverts. On agrège et enrichit
            ces sources pour te proposer une expérience claire et à jour.
          </p>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="rounded-lg border border-outline-variant/30 bg-surface-container-low p-4">
              <span class="mb-1 block font-bold text-primary">Ville de Toulouse — Open Data</span>
              <span class="font-label-sm text-label-sm text-on-surface-variant">
                Lieux, monuments et patrimoine local.
              </span>
            </div>
            <div class="rounded-lg border border-outline-variant/30 bg-surface-container-low p-4">
              <span class="mb-1 block font-bold text-primary">OpenAgenda</span>
              <span class="font-label-sm text-label-sm text-on-surface-variant">
                Événements culturels, festivals et animations toulousaines.
              </span>
            </div>
            <div class="rounded-lg border border-outline-variant/30 bg-surface-container-low p-4">
              <span class="mb-1 block font-bold text-primary">Contributeurs cartographiques</span>
              <span class="font-label-sm text-label-sm text-on-surface-variant">
                Fonds de carte et données géographiques libres.
              </span>
            </div>
            <div class="rounded-lg border border-outline-variant/30 bg-surface-container-low p-4">
              <span class="mb-1 block font-bold text-primary">Wikimedia Commons</span>
              <span class="font-label-sm text-label-sm text-on-surface-variant">
                Photographies sous licences libres, créditées sur chaque fiche.
              </span>
            </div>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-gutter md:col-span-4">
        <div class="sticky-note flex flex-1 flex-col items-center justify-center rounded-xl border-2 border-dashed border-soft-pink bg-soft-pink/30 p-8 text-center">
          <span class="material-symbols-outlined mb-4 text-4xl text-primary">mail</span>
          <h3 class="mb-2 font-headline-md text-headline-md text-deep-rose">Un mot doux ?</h3>
          <p class="mb-6 font-label-md text-label-md">Une erreur, une suggestion ou juste envie de dire bonjour ?</p>
          <a class="font-headline-md text-primary underline underline-offset-4 hover:text-deep-rose" href={`mailto:${SITE_CONTACT_EMAIL}`}>
            {SITE_CONTACT_EMAIL}
          </a>
        </div>
      </div>

      <div class="paper-card rounded-xl bg-white p-8 md:col-span-5">
        <div class="mb-6 flex items-center gap-3">
          <span class="material-symbols-outlined text-3xl text-terra-cotta">group</span>
          <h2 class="font-headline-md text-headline-md text-ink-black">Remerciements</h2>
        </div>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-sky-blue-muted">
              <span class="text-xs font-bold text-white">LC</span>
            </div>
            <div>
              <p class="font-label-md text-ink-black">La communauté</p>
              <p class="font-label-sm text-label-sm text-on-surface-variant">
                Pour les retours, signalements et coups de cœur partagés via l'app.
              </p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-soft-pink">
              <span class="text-xs font-bold text-white">CC</span>
            </div>
            <div>
              <p class="font-label-md text-ink-black">Photographes Commons</p>
              <p class="font-label-sm text-label-sm text-on-surface-variant">
                Aux auteurs Wikimedia dont les images donnent vie à Toulouse dans l'app.
              </p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-terra-cotta">
              <span class="text-xs font-bold text-white">OS</span>
            </div>
            <div>
              <p class="font-label-md text-ink-black">Open Source</p>
              <p class="font-label-sm text-label-sm text-on-surface-variant">
                Aux développeurs des bibliothèques qui font tourner TouRose.
              </p>
            </div>
          </li>
        </ul>
      </div>

      <div class="paper-card rounded-xl bg-surface-container p-8 md:col-span-7">
        <div class="mb-6 flex items-center gap-3">
          <span class="material-symbols-outlined text-3xl text-on-surface-variant">gavel</span>
          <h2 class="font-headline-md text-headline-md text-ink-black">Mentions Légales Simplifiées</h2>
        </div>
        <div class="space-y-6 text-on-surface-variant">
          <div>
            <h4 class="mb-1 font-label-md text-deep-rose">Édition &amp; Développement</h4>
            <p class="font-body-md text-body-md">
              TouRose est un projet indépendant, conçu et développé à Toulouse. Contact : {SITE_CONTACT_EMAIL}
            </p>
          </div>
          <div>
            <h4 class="mb-1 font-label-md text-deep-rose">Hébergement</h4>
            <p class="font-body-md text-body-md">
              Données et services hébergés en Europe via Supabase, avec respect de ta vie privée.
            </p>
          </div>
          <div>
            <h4 class="mb-1 font-label-md text-deep-rose">Propriété Intellectuelle</h4>
            <p class="font-body-md text-body-md">
              Les textes originaux et la direction artistique TouRose sont protégés. Les photos appartiennent à leurs
              auteurs respectifs, cités sur chaque fiche.
            </p>
          </div>
          <div class="flex gap-4 pt-4">
            <a class="font-bold text-primary hover:underline" href="/confidentialite">Politique de Confidentialité</a>
            <a class="font-bold text-primary hover:underline" href={`mailto:${SITE_CONTACT_EMAIL}`}>Contact</a>
          </div>
        </div>
      </div>

      <div class="group relative h-80 overflow-hidden rounded-xl md:col-span-12">
        <img
          src={photoBannerImage}
          alt="La Garonne et le Pont Neuf à Toulouse"
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink-black/80 to-transparent" />
        <div class="absolute bottom-8 left-8 text-white">
          <span class="material-symbols-outlined mb-2 text-soft-pink">photo_camera</span>
          <p class="font-headline-md text-headline-md">L'œil de Toulouse</p>
          <p class="max-w-lg font-body-md text-body-md opacity-90">
            Merci aux photographes de Wikimedia Commons et aux sources ouvertes pour les visuels qui rendent l'app si
            vivante.
          </p>
        </div>
      </div>
    </div>
  </main>

  <script>
    document.querySelectorAll('.paper-card').forEach((cardElement) => {
      cardElement.addEventListener('mouseenter', () => {
        cardElement.style.transform = 'translateY(-4px)';
        cardElement.style.transition = 'transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)';
      });
      cardElement.addEventListener('mouseleave', () => {
        cardElement.style.transform = 'translateY(0)';
      });
    });
  </script>
</BaseLayout>
