---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="TouRose — Toulouse à voir, à vivre, à aimer.">
  <section class="grid gap-8 pt-10">
    <div class="flex flex-wrap items-center gap-4 md:gap-5">
      <img
        src="/brand/logo-icon.png"
        alt=""
        width="96"
        height="96"
        class="h-20 w-20 shrink-0 md:h-24 md:w-24"
        aria-hidden="true"
      />
      <img
        src="/brand/logo-wordmark.png"
        alt="TouRose"
        width="791"
        height="208"
        class="h-10 w-auto max-w-full md:h-14"
      />
    </div>
    <h1 class="max-w-2xl text-2xl font-medium text-ink-700 md:text-3xl">
      Toulouse à voir, à vivre, à aimer.
    </h1>
    <p class="max-w-xl text-lg text-ink-600">
      Trois idées adaptées à ta situation, puis tout Toulouse à portée de main. L’application mobile
      arrive bientôt — ce site présente le projet, les sources et la confidentialité.
    </p>
    <div class="flex flex-wrap gap-3">
      <a class="rounded-lg bg-brick-500 px-5 py-3 text-white no-underline" href="/catalogue">
        Voir le catalogue
      </a>
      <a class="rounded-lg bg-garonne-500 px-5 py-3 text-white no-underline" href="/credits">
        Voir les sources
      </a>
      <a
        class="rounded-lg border border-ink-700/20 px-5 py-3 text-ink-700 no-underline"
        href="/confidentialite"
      >
        Confidentialité
      </a>
    </div>
  </section>
</BaseLayout>
